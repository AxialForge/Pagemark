+import 'package:flutter_test/flutter_test.dart';
+import 'package:pagemark/backup.dart';
+
+void main() {
+  test('backup file names round-trip the pattern', () {
+    final t = DateTime(2026, 3, 7, 9, 5);
+    expect(backupFileName(t, encrypted: true), 'pagemark-20260307-0905.pgbak');
+    expect(backupFileName(t, encrypted: false), 'pagemark-20260307-0905.sqlite');
+    expect(isBackupName(backupFileName(t, encrypted: true)), isTrue);
+    expect(isBackupName(backupFileName(t, encrypted: false)), isTrue);
+  });
+
+  test('isBackupName rejects other files', () {
+    for (final n in ['notes.txt', 'pagemark-20260307-0905.pgbak (1)', 'pagemark-2026-0905.pgbak', 'x-pagemark-20260307-0905.pgbak', 'pagemark-20260307-0905.zip']) {
+      expect(isBackupName(n), isFalse, reason: n);
+    }
+  });
+
+  test('namesToPrune keeps the newest and never touches foreign files', () {
+    final names = [
+      for (var d = 1; d <= 8; d++) 'pagemark-202603${d.toString().padLeft(2, '0')}-0100.pgbak',
+      'holiday.jpg',
+      'pagemark-20260101-0100.sqlite',
+    ];
+    final doomed = namesToPrune(names);
+    expect(doomed.length, 4);
+    expect(doomed, containsAll(['pagemark-20260303-0100.pgbak', 'pagemark-20260302-0100.pgbak', 'pagemark-20260301-0100.pgbak', 'pagemark-20260101-0100.sqlite']));
+    expect(doomed.contains('holiday.jpg'), isFalse);
+    expect(namesToPrune(names.take(3)), isEmpty);
+  });
+
+  test('backupDue follows the schedule', () {
+    final now = DateTime(2026, 3, 10, 12);
+    expect(backupDue(null, 'daily', now), isTrue);
+    expect(backupDue(now.subtract(const Duration(hours: 3)), 'daily', now), isFalse);
+    expect(backupDue(now.subtract(const Duration(hours: 23)), 'daily', now), isTrue); // inside the 2 h slack
+    expect(backupDue(now.subtract(const Duration(days: 3)), 'weekly', now), isFalse);
+    expect(backupDue(now.subtract(const Duration(days: 7)), 'weekly', now), isTrue);
+  });
+}
