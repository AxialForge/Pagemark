+/// First launch on a phone: if Android restored an encrypted copy and the library is empty, offer to use it.
+/// Always marks the first run done afterwards so the phone copy can start refreshing.
+Future<void> maybeOfferPhoneRestore(BuildContext context) async {
+  if (await Backup.firstRunDone()) return;
+  final copy = await Backup.restoredPhoneCopy();
+  final empty = (await db.select(db.books).get()).isEmpty;
+  if (copy == null || !empty) {
+    await Backup.markFirstRunDone();
+    return;
+  }
+  if (!context.mounted) return;
+  final yes = await showDialog<bool>(
+    context: context,
+    builder: (c) => AlertDialog(
+      title: const Text('Restore your library?'),
+      content: const Text('Pagemark found an encrypted backup that came over from your previous phone. '
+          'You\'ll need the backup passphrase you set there.'),
+      actions: [
+        TextButton(onPressed: () => Navigator.pop(c, false), child: const Text('Start empty')),
+        FilledButton(onPressed: () => Navigator.pop(c, true), child: const Text('Restore')),
+      ],
+    ),
+  );
+  if (yes == true && context.mounted) {
+    await restoreFlow(context, copy); // exits the app on success; first run is marked on the next launch (library non-empty)
+    return;
+  }
+  await Backup.markFirstRunDone();
+}
