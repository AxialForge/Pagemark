+  /// Study guides, summaries and the like that Open Library returns alongside the real book.
+  static final _junkTitle = RegExp(r'^(summary|study guide|workbook|analysis|trivia|quiz)\b|summary of|study guide', caseSensitive: false);
+
+  /// Order search results so the real book comes first: +3 has a cover, +2 an author name appears in the query,
+  /// -5 looks like a summary/study guide/workbook. Stable: ties keep Open Library's own order.
+  static List<BookMeta> rank(List<BookMeta> results, String query) {
+    final words = query.toLowerCase().split(RegExp(r'[^a-z0-9]+')).where((w) => w.length > 2).toSet();
+    int score(BookMeta m) {
+      var s = 0;
+      if (m.coverUrl.isNotEmpty) s += 3;
+      final authorWords = m.author.toLowerCase().split(RegExp(r'[^a-z0-9]+')).where((w) => w.length > 2);
+      if (authorWords.any(words.contains)) s += 2;
+      if (_junkTitle.hasMatch(m.title.trim())) s -= 5;
+      return s;
+    }
+
+    final scored = [for (var i = 0; i < results.length; i++) (i, score(results[i]), results[i])];
+    scored.sort((a, b) => b.$2 != a.$2 ? b.$2.compareTo(a.$2) : a.$1.compareTo(b.$1));
+    return [for (final e in scored) e.$3];
+  }
+
